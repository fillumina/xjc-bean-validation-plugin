<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:a="a" targetNamespace="a">
    <xs:simpleType name="Code"><xs:restriction base="xs:string"><xs:maxLength value="3"/><xs:pattern value="[A-Z]+"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="Codes"><xs:list itemType="a:Code"/></xs:simpleType>
    <xs:simpleType name="CodeRange"><xs:restriction base="a:Codes"><xs:minLength value="1"/><xs:maxLength value="4"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="TwoCodes"><xs:restriction base="a:CodeRange"><xs:length value="2"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="Number"><xs:restriction base="xs:decimal"><xs:totalDigits value="2"/><xs:fractionDigits value="1"/><xs:minExclusive value="0"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="Numbers"><xs:list itemType="a:Number"/></xs:simpleType>
    <xs:simpleType name="TwoNumbers"><xs:restriction base="a:Numbers"><xs:length value="2"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="CodeEnum"><xs:restriction base="xs:string"><xs:maxLength value="2"/><xs:enumeration value="AA"/><xs:enumeration value="BB"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="EnumCodes"><xs:list itemType="a:CodeEnum"/></xs:simpleType>
    <xs:simpleType name="TwoEnumCodes"><xs:restriction base="a:EnumCodes"><xs:length value="2"/></xs:restriction></xs:simpleType>
    <xs:complexType name="ListAttributes">
        <xs:attribute name="codes" type="a:TwoCodes"/>
        <xs:attribute name="numbers" type="a:TwoNumbers"/>
        <xs:attribute name="required" type="a:TwoCodes" use="required"/>
        <xs:attribute name="enumCodes" type="a:TwoEnumCodes"/>
    </xs:complexType>
    <xs:complexType name="ListContent"><xs:simpleContent><xs:extension base="a:TwoCodes"/></xs:simpleContent></xs:complexType>
    <xs:complexType name="EnumContent"><xs:simpleContent><xs:extension base="a:TwoEnumCodes"/></xs:simpleContent></xs:complexType>
</xs:schema>
